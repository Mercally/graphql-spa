# Copy this file to .env and adjust as needed.
# All URLs/connection details are configurable per Requirements.md section 25 —
# nothing should be hardcoded in application code.

# ── MongoDB ────────────────────────────────────────────────────────
# Used by docker-compose.yml, the seed script (scripts/seed), and both backends.
MONGODB_CONNECTION_STRING=mongodb://localhost:27017
MONGODB_DATABASE=workmanagement
MONGODB_PORT=27017

# ── .NET backend (REST + GraphQL on the same Kestrel host) ─────────
DOTNET_API_URL=http://localhost:5000
DOTNET_GRAPHQL_URL=http://localhost:5000/graphql

# ── Node backend (REST + GraphQL on the same host) ──────────────────
NODE_API_URL=http://localhost:4000
NODE_GRAPHQL_URL=http://localhost:4000/graphql
