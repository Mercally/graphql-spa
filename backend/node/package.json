{
  "name": "backend-node",
  "version": "1.0.0",
  "description": "Node.js + TypeScript backend (REST via Fastify, GraphQL via Mercurius) for the REST vs GraphQL PoC. Shares one MongoDB instance/schema with the .NET backend.",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.1",
    "graphql": "^16.9.0",
    "mercurius": "^16.10.0",
    "mongodb": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
