@model UserVm
@{
    ViewData["Title"] = Model.Name;
}

<h2>@Model.Name</h2>
<dl class="row">
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Role</dt>
    <dd class="col-sm-10"><span class="badge bg-info text-dark">@Model.Role</span></dd>
</dl>
