@model TaskDetailVm
@{
    ViewData["Title"] = Model.Title;
}

<p><a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId">&larr; Back to project</a></p>

<h2>@Model.Title <span class="badge bg-secondary">@Model.Status</span></h2>
<p>@Model.Description</p>

<dl class="row">
    <dt class="col-sm-2">Assigned to</dt>
    <dd class="col-sm-10">
        @if (Model.AssignedUser != null)
        {
            <a asp-controller="User" asp-action="Details" asp-route-id="@Model.AssignedUser.Id">@Model.AssignedUser.Name</a>
            <span class="text-muted">(@Model.AssignedUser.Role)</span>
        }
        else
        {
            <span class="text-muted">unassigned</span>
        }
    </dd>

    <dt class="col-sm-2">Tags</dt>
    <dd class="col-sm-10">
        @if (Model.Tags.Count == 0)
        {
            <span class="text-muted">none</span>
        }
        else
        {
            @foreach (var tag in Model.Tags)
            {
                <span class="badge" style="background-color:@tag.Color">@tag.Name</span>
            }
        }
    </dd>
</dl>

<h4>Comments (@Model.Comments.Count)</h4>
@if (Model.Comments.Count == 0)
{
    <p class="text-muted">No comments on this task.</p>
}
else
{
    <ul class="list-group">
        @foreach (var c in Model.Comments.OrderBy(c => c.CreatedAt))
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between">
                    <strong>
                        @if (c.User != null)
                        {
                            <a asp-controller="User" asp-action="Details" asp-route-id="@c.User.Id">@c.User.Name</a>
                        }
                        else
                        {
                            <span class="text-muted">unknown user</span>
                        }
                    </strong>
                    <span class="text-muted small">@c.CreatedAt.ToString("yyyy-MM-dd")</span>
                </div>
                <p class="mb-0">@c.Text</p>
            </li>
        }
    </ul>
}
