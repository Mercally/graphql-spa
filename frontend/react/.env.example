# Backend base URLs. Both backends expose an identical schema/behavior.
VITE_DOTNET_API_URL=http://localhost:5000/api
VITE_DOTNET_GRAPHQL_URL=http://localhost:5000/graphql

VITE_NODE_API_URL=http://localhost:4000/api
VITE_NODE_GRAPHQL_URL=http://localhost:4000/graphql

# Which backend to use by default: "dotnet" | "node".
# Can also be switched at runtime from the Settings bar in the app (persisted in localStorage).
VITE_DEFAULT_BACKEND=node

# Which data mode to use by default: "rest" | "graphql".
# Can also be switched at runtime from the Settings bar in the app (persisted in localStorage).
VITE_DEFAULT_MODE=rest
